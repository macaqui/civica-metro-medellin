generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tarjeta {
  id     Int      @id @default(autoincrement())
  nombre String
  tipo   String   @default("Personalizada")
  numero String
  serial String
  activa Boolean  @default(true)
  creada DateTime @default(now())
}
